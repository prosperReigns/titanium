{
  "name": "titanium-5-collections",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @titanium/web --filter @titanium/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @titanium/api db:generate",
    "db:migrate": "pnpm --filter @titanium/api db:migrate",
    "db:seed": "pnpm --filter @titanium/api db:seed",
    "db:studio": "pnpm --filter @titanium/api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}